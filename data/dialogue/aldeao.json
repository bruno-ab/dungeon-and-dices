      "text": "{quest_text}",
      "next": "hub_again"
    },
    "hub_again": {
      "text": "É só isso?",
      "choices": [
        { "text": "Direções", "next": "directions" },
        { "text": "Magus", "next": "about_magus" },
        { "text": "Novidades", "next": "news" },
        { "text": "Adeus", "next": "bye" }
